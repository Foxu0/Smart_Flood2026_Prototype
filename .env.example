# ==============================================================================
# SmartFlood 2026 — Server Environment Template (.env.example)
# Copy this file to .env and adjust values as needed.
# ==============================================================================

PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5174,http://127.0.0.1:5174

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=smartflood_eoc_secure_jwt_token_secret_key_2026
JWT_EXPIRES_IN=24h

# ADMIN_USERNAME / ADMIN_PASSWORD seed the first SUPERADMIN account on startup (once).
# With a real database the password must be 10+ chars and not equal the username.
# SEED_DEMO_ACCOUNTS: true = demo MDRRMO/Barangay accounts in memory mode only;
#                     force = also seed them into the database (never in production).
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=smartflood2026

# Each board sends its own code (printed on its sticker; staff type it on Hardware → Add board).
# Readings without a code (current firmware) go to the default board while this is false.
# Set to true once all boards run the firmware with a board code.
REQUIRE_DEVICE_KEY=false
# Seconds without a report before a board shows as "Not reporting"
DEVICE_OFFLINE_AFTER_SEC=120

SENSOR_MOUNT_HEIGHT_CM=240
SENSOR_BLIND_SPOT_CM=25

CITY_LAT=14.5869
CITY_LON=121.1754
DATA_RETENTION_DAYS=30

# WEATHER_API_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/smartflood?schema=public
# DIRECT_URL=postgresql://user:password@localhost:5432/smartflood?schema=public
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM="SmartFlood Alerts <alerts@smartflood.local>"

# SMS alerts: leave empty to SIMULATE texts (saved in sms_logs, nothing is sent).
# To send real texts, create a Semaphore account (semaphore.co), buy credits, and paste the API key here.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=SMARTFLOOD
