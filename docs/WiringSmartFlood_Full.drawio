        <mxCell id="n1107" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;size=14;" value="Wire &amp; Connector Guide:  22 AWG solid copper -- used throughout.  2A Inline Fuse -- ONE fuse total. Splices into the +12V line right after the Barrel Jack; only that wire is marked (fused line).  12V Split: 1x WAGO 221-413 (3-port)   feeds Buck, Relay COM, Battery Divider Relay-Siren GND: 1x WAGO 221-412 (2-port)  5V/GND: distributed via breadboard power rails -- no WAGO needed for this phase.  ECHO Divider: R1 10k + R2 22k Ohm   protects GPIO18 from JSN&#39;s 5V ECHO pulse  Battery Divider: R1 100k + R2 22k Ohm   steps 12V down for GPIO34 (ADC)" vertex="1">
          <mxGeometry height="280" width="280" x="1300" y="130" as="geometry" />
        </mxCell>
